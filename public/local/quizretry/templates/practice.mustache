{{!
    @template local_quizretry/practice

    Practice page: the questions to redo, or the review of a submitted practice.

    Context variables required for this template:
    * finished - true when the practice has been submitted
    * actionurl - form action URL (in progress only)
    * sesskey - session key
    * intro - intro text (in progress only)
    * questions - list of rendered questions (html)
    * finishlabel - submit button text
    * slots - comma separated slot numbers contained in the form
    * summary - result text (finished only)
    * allcorrect - true if every question is now correct
    * allcorrectmsg - congratulation text
    * canretry - true if a further practice on remaining wrong questions can be started
    * startaction, fields, retrylabel - data for that start form
    * reviewurl, reviewlabel - link back to the original attempt review
    * quizurl, quizlabel - link back to the quiz
    * historyurl, historylabel - link to the practice history

    Example context (json):
    {
        "finished": true,
        "actionurl": "https://example.com/local/quizretry/attempt.php?id=4",
        "sesskey": "abc123",
        "intro": "Answer the 3 questions below.",
        "questions": [{"html": "<div class=\"que\">Question html</div>"}],
        "finishlabel": "Submit practice",
        "slots": "1,2,3",
        "summary": "You answered 2 of 3 questions correctly.",
        "allcorrect": false,
        "canretry": true,
        "startaction": "https://example.com/local/quizretry/start.php",
        "fields": [{"name": "retry", "value": "4"}],
        "retrylabel": "Retry the 1 question still incorrect",
        "reviewurl": "https://example.com/mod/quiz/review.php?attempt=12",
        "reviewlabel": "Back to attempt review",
        "quizurl": "https://example.com/mod/quiz/view.php?id=5",
        "quizlabel": "Back to the quiz",
        "historyurl": "https://example.com/local/quizretry/index.php?cmid=5",
        "historylabel": "My practice history"
    }
}}
<div class="local-quizretry-practice" data-region="local-quizretry-practice">
    {{#finished}}
        <div class="alert {{#allcorrect}}alert-success{{/allcorrect}}{{^allcorrect}}alert-info{{/allcorrect}}" role="status">
            <strong>{{summary}}</strong>
            {{#allcorrectmsg}}<div>{{allcorrectmsg}}</div>{{/allcorrectmsg}}
        </div>
    {{/finished}}
    {{^finished}}
        <div class="alert alert-info" role="status">{{intro}}</div>
        <form id="local-quizretry-form" method="post" action="{{actionurl}}" enctype="multipart/form-data" accept-charset="utf-8">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="mdlscrollto" id="mdlscrollto" value="">
    {{/finished}}

    {{#questions}}
        {{{html}}}
    {{/questions}}

    {{^finished}}
            <div class="mt-3">
                <input type="submit" name="finishpractice" value="{{finishlabel}}" class="btn btn-primary">
            </div>
            <input type="hidden" name="slots" value="{{slots}}">
        </form>
    {{/finished}}

    {{#finished}}
        <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
            {{#canretry}}
                <form method="post" action="{{startaction}}" class="d-inline">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{#fields}}
                        <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/fields}}
                    <button type="submit" class="btn btn-primary">{{retrylabel}}</button>
                </form>
            {{/canretry}}
            {{#reviewurl}}<a class="btn btn-secondary" href="{{reviewurl}}">{{reviewlabel}}</a>{{/reviewurl}}
            <a class="btn btn-secondary" href="{{quizurl}}">{{quizlabel}}</a>
            <a class="btn btn-link" href="{{historyurl}}">{{historylabel}}</a>
        </div>
    {{/finished}}
</div>
