{{!
    @template local_quizretry/retry_card

    Card shown on the quiz review and view pages offering to practise the wrong questions.

    Context variables required for this template:
    * title - card heading
    * message - explanation text
    * canstart - true to show the start button
    * startaction - form action URL
    * sesskey - session key
    * fields - hidden fields (name, value) sent to the start page
    * startlabel - start button text
    * resumeurl - optional URL of an unfinished practice
    * resumelabel - text for the resume link
    * historyurl - URL of the practice history
    * historylabel - text for the history link

    Example context (json):
    {
        "title": "Practise your mistakes",
        "message": "You answered 3 questions incorrectly.",
        "canstart": true,
        "startaction": "https://example.com/local/quizretry/start.php",
        "sesskey": "abc123",
        "fields": [{"name": "attempt", "value": "12"}],
        "startlabel": "Retry 3 incorrect questions",
        "resumeurl": "https://example.com/local/quizretry/attempt.php?id=4",
        "resumelabel": "Continue practice",
        "historyurl": "https://example.com/local/quizretry/index.php?cmid=5",
        "historylabel": "My practice history"
    }
}}
<div class="local-quizretry-card card my-3" data-region="local-quizretry-card">
    <div class="card-body">
        <h3 class="h5 card-title">{{title}}</h3>
        <p class="card-text">{{message}}</p>
        <div class="d-flex flex-wrap align-items-center gap-2">
            {{#canstart}}
                <form method="post" action="{{startaction}}" class="d-inline">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    {{#fields}}
                        <input type="hidden" name="{{name}}" value="{{value}}">
                    {{/fields}}
                    <button type="submit" class="btn btn-primary">{{startlabel}}</button>
                </form>
            {{/canstart}}
            {{#resumeurl}}
                <a class="btn btn-secondary" href="{{resumeurl}}">{{resumelabel}}</a>
            {{/resumeurl}}
            <a class="btn btn-link" href="{{historyurl}}">{{historylabel}}</a>
        </div>
    </div>
</div>
