{{!
    @template local_studytimer/navbar_toggle

    Navbar clock icon button to toggle the floating study timer popup.
}}
<div class="popover-region local-studytimer-nav-item d-flex align-items-center">
    <button type="button"
            id="local-studytimer-nav-toggle"
            class="nav-link icon-no-margin btn btn-link local-studytimer-nav-btn"
            title="{{title}}"
            aria-label="{{title}}"
            aria-expanded="false">
        <i class="icon fa fa-clock-o fa-regular fa-clock fa-fw" aria-hidden="true"></i>
        <span id="local-studytimer-nav-badge" class="local-studytimer-nav-badge d-none"></span>
    </button>
</div>
